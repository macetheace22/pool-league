# Copy this file to .env for local development.
# For deployment, set these same two values in your host's project settings
# (e.g. Vercel: Project Settings -> Environment Variables) instead of committing a .env file.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only variables required by the daily IBA schedule monitor (never use VITE_ prefixes).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CRON_SECRET=your-long-random-cron-secret
